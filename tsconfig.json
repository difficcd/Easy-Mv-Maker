{
  // Checking only - no files are emitted, Vite does the building.
  //
  // Everything under src is TypeScript and held to strict (#268). This began as a lenient
  // check over the JavaScript, with a second config holding the converted files to strict
  // until the last folder was through; with nothing left to convert, the one config is strict.
  // (An unbound accentSoft was the first bug the checker caught, back when it was lenient.)
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    // Importers name a .ts module with its extension: Node's type stripping needs the real file
    // name, and with noEmit there is nothing for the extension to be wrong about.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
