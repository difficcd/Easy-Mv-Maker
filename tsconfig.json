{
  // Checking only - no files are emitted, Vite does the building. Two purposes, two configs:
  //
  // This one covers everything under src, JavaScript included, with the strict options off so
  // the existing .js/.jsx is checked for the mistakes that otherwise surface at runtime - a
  // name that does not exist, a misspelt prop - without going red end to end. (An unbound
  // accentSoft was the first bug it caught.)
  //
  // tsconfig.strict.json extends it for the TypeScript files only, with strict on: a file that
  // has been converted is held to the full standard, and the JavaScript is left as it is until
  // its turn. `npm run typecheck` runs both.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    // Importers name a .ts module with its extension: Node's type stripping needs the real file
    // name, and with noEmit there is nothing for the extension to be wrong about.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
