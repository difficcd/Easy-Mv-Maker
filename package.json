{
  "name": "easy-mv-maker",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:server\" \"npm:web\"",
    "web": "vite",
    "dev:host": "vite --host",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run build && npx cap run android",
    "test": "node --test test/*.test.js",
    "bench": "node scripts/bench.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check": "npm run typecheck && npm test && node scripts/hook-baseline.mjs && node scripts/helper-index.mjs && npm run build",
    "smoke": "node test/smoke/boot.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "express": "^5.2.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^6.1.1",
    "vite-plugin-qrcode": "^0.4.1",
    "wait-on": "^9.1.0"
  }
}
